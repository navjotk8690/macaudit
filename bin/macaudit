#!/bin/bash
set -u
PATH=/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin
umask 077

VERSION="3.2.5"
BASE="/Library/Application Support/MacAudit"
LOG_DIR="/Library/Logs/MacAudit"
CONF="$BASE/macaudit.conf"
STATE="$BASE/state"
SNAP="$BASE/snapshots"
EVENTS="$LOG_DIR/events.jsonl"
DASH_EVENTS="$BASE/dashboard-events.jsonl"
HEALTH="$BASE/health.json"
LOCK="$STATE/run.lock"
NOTIFY_STATE="$STATE/notifications"

RETENTION_DAYS=90 ENABLE_NOTIFICATIONS=1 NOTIFY_MIN_SEVERITY=HIGH
NOTIFICATION_COOLDOWN_SECONDS=900 ENABLE_UNIFIED_LOG_SCAN=1 ENABLE_TCC_SCAN=1
ENABLE_JUMPCLOUD_SCAN=1 DASHBOARD_ENABLED=1 DASHBOARD_PORT=8765
FAST_INTERVAL_SECONDS=60 STANDARD_INTERVAL_SECONDS=300 SLOW_INTERVAL_SECONDS=1800

now_iso(){ date -u '+%Y-%m-%dT%H:%M:%SZ'; }
json_escape(){ /usr/bin/perl -0777 -pe 's/\\/\\\\/g; s/"/\\"/g; s/\r/\\r/g; s/\n/\\n/g; s/\t/\\t/g'; }
valid_int(){ [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]; }
severity_rank(){ case "$1" in INFO) echo 0;; LOW) echo 1;; MEDIUM) echo 2;; HIGH) echo 3;; CRITICAL) echo 4;; *) echo 0;; esac; }
log(){ printf '%s %s\n' "$(now_iso)" "$*" >> "$LOG_DIR/agent.log"; }

load_config(){
  [ -r "$CONF" ] || return 0
  while IFS='=' read -r key value; do
    key="${key%%[[:space:]]*}"; value="${value%$'\r'}"
    [[ -z "$key" || "$key" == \#* ]] && continue
    case "$key" in
      RETENTION_DAYS) valid_int "$value" 1 3650 && RETENTION_DAYS="$value";;
      ENABLE_NOTIFICATIONS|ENABLE_UNIFIED_LOG_SCAN|ENABLE_TCC_SCAN|ENABLE_JUMPCLOUD_SCAN|DASHBOARD_ENABLED) [[ "$value" == 0 || "$value" == 1 ]] && printf -v "$key" '%s' "$value";;
      NOTIFY_MIN_SEVERITY) [[ "$value" =~ ^(INFO|LOW|MEDIUM|HIGH|CRITICAL)$ ]] && NOTIFY_MIN_SEVERITY="$value";;
      NOTIFICATION_COOLDOWN_SECONDS) valid_int "$value" 0 86400 && NOTIFICATION_COOLDOWN_SECONDS="$value";;
      DASHBOARD_PORT) valid_int "$value" 1024 65535 && DASHBOARD_PORT="$value";;
      FAST_INTERVAL_SECONDS|STANDARD_INTERVAL_SECONDS|SLOW_INTERVAL_SECONDS) valid_int "$value" 30 86400 && printf -v "$key" '%s' "$value";;
      *) log "Ignored unknown configuration key: $key";;
    esac
  done < "$CONF"
}

require_root(){ [ "$(id -u)" -eq 0 ] || { echo "MacAudit must run as root. Use sudo." >&2; exit 1; }; }
setup(){ mkdir -p "$STATE" "$SNAP" "$LOG_DIR" "$NOTIFY_STATE"; chmod 700 "$BASE" "$STATE" "$SNAP" "$NOTIFY_STATE" 2>/dev/null || true; chmod 750 "$LOG_DIR" 2>/dev/null || true; touch "$EVENTS" "$DASH_EVENTS"; chmod 600 "$EVENTS" "$DASH_EVENTS" 2>/dev/null || true; load_config; }

acquire_lock(){
  if mkdir "$LOCK" 2>/dev/null; then
    printf '%s\n' "$$" > "$LOCK/pid"; printf '%s\n' "$(date +%s)" > "$LOCK/started"; trap 'rm -rf "$LOCK"' EXIT INT TERM; return 0
  fi
  local pid=""; [ -r "$LOCK/pid" ] && pid="$(cat "$LOCK/pid" 2>/dev/null || true)"
  if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then log "Scan skipped: process $pid still owns the lock"; exit 0; fi
  rm -rf "$LOCK"; log "Recovered stale scan lock"
  mkdir "$LOCK" || exit 1; printf '%s\n' "$$" > "$LOCK/pid"; printf '%s\n' "$(date +%s)" > "$LOCK/started"; trap 'rm -rf "$LOCK"' EXIT INT TERM
}

notify_user(){
  local severity="$1" category="$2" message="$3" fingerprint="$4"
  [ "$ENABLE_NOTIFICATIONS" = 1 ] || return 0
  [ "$(severity_rank "$severity")" -ge "$(severity_rank "$NOTIFY_MIN_SEVERITY")" ] || return 0
  local stamp="$NOTIFY_STATE/$fingerprint" now last=0 uid user safe title
  now="$(date +%s)"; [ -f "$stamp" ] && last="$(cat "$stamp" 2>/dev/null || echo 0)"
  [ $((now-last)) -ge "$NOTIFICATION_COOLDOWN_SECONDS" ] || return 0
  uid="$(stat -f '%u' /dev/console 2>/dev/null || echo 0)"; user="$(stat -f '%Su' /dev/console 2>/dev/null || true)"
  [ "$uid" -gt 500 ] 2>/dev/null && [ -n "$user" ] || return 0
  safe="$(printf '%s' "$message" | tr '\n\r' '  ' | sed 's/["\\]/ /g' | cut -c1-220)"; title="MacAudit: $severity"
  if launchctl asuser "$uid" sudo -u "$user" /usr/bin/osascript -e "display notification \"$safe\" with title \"$title\" sound name \"Submarine\"" >/dev/null 2>&1; then printf '%s' "$now" > "$stamp"; fi
}

friendly_fields(){
  case "$1" in
    active-ssh) echo 'Someone connected using SSH|A remote computer has an active command-line connection to this Mac.|Expected when you or trusted IT staff intentionally use Remote Login.|Confirm the connected user and source address. Turn off Remote Login if it is not needed.';;
    remote-software) echo 'Remote-support software is running|An app capable of viewing or controlling this Mac is currently running.|Expected during an approved support session or when your organisation manages the Mac.|Close the app if you did not start it and contact your IT or security team.';;
    remote-sockets) echo 'A remote-support app is communicating online|A remote-support process has an active non-local network connection.|Many support tools stay connected to their service while idle, so this does not prove someone is controlling the Mac.|Check whether the app is approved and whether a support session is expected.';;
    privacy-permissions) echo 'Privacy permissions changed|An app gained, lost, or changed access to protected Mac features such as screen recording, accessibility, camera, microphone, or files.|Expected after approving a trusted app or after a software update.|Review System Settings > Privacy & Security and remove access you do not recognise.';;
    identity) echo 'A user or administrator account changed|The list of local users or administrators is different from the previous scan.|Expected when IT creates or removes an approved account.|Review the account name. Unexpected administrator access should be investigated immediately.';;
    persistence) echo 'An automatic-start item changed|A LaunchAgent, LaunchDaemon, scheduled task, or similar startup item was added, removed, or modified.|Expected after installing or updating trusted software.|Check the changed path and publisher. Remove unknown items only after confirming they are not required.';;
    security-settings) echo 'A security setting changed|A core macOS protection or remote-access setting differs from the previous scan.|Expected when you or IT intentionally change security or sharing settings.|Review FileVault, firewall, Gatekeeper, SIP, Remote Login, and Remote Apple Events.';;
    device-management) echo 'Device management changed|MDM enrolment or a system extension changed.|Expected on a company-managed Mac or after approved security software changes.|Confirm the organisation and extension are trusted.';;
    software) echo 'Installed software changed|An application or installer package was added or removed.|Expected when installing, updating, or uninstalling software.|Review unfamiliar applications and packages.';;
    remote-session) echo 'Possible remote-control session detected|MacAudit found a strong log message associated with a remote session.|Expected only during an approved remote-support session.|If no session was expected, disconnect from the network and contact your security team.';;
    remote-access) echo 'Remote-access capability changed|Remote Login, Screen Sharing, Apple Remote Desktop, a listening remote port, or a support process changed.|Expected when sharing features or approved support software are enabled or disabled.|Review System Settings > General > Sharing and any running support tools.';;
    ssh) echo 'SSH configuration changed|Remote Login activity, authorised keys, or SSH configuration changed.|Expected when approved keys or settings are updated.|Review authorised keys and disable Remote Login if unused.';;
    *) echo 'Mac security activity detected|MacAudit noticed a change worth recording.|This may be normal after a deliberate system or software change.|Review the details and confirm the activity was expected.';;
  esac
}

emit(){
  local severity="$1" category="$2" message="$3" evidence="${4:-}" key="${5:-$2|$3}" state="${6:-changed}"
  local fp hash oldfile old ts host user fields title why normal action
  fp="$(printf '%s' "$key" | shasum -a 256 | awk '{print $1}')"; oldfile="$STATE/event-$fp.hash"
  hash="$(printf '%s\n%s\n%s' "$message" "$evidence" "$state" | shasum -a 256 | awk '{print $1}')"; old="$(cat "$oldfile" 2>/dev/null || true)"
  [ "$hash" = "$old" ] && return 0; printf '%s' "$hash" > "$oldfile"
  ts="$(now_iso)"; host="$(scutil --get ComputerName 2>/dev/null || hostname)"; user="$(stat -f '%Su' /dev/console 2>/dev/null || echo unknown)"
  fields="$(friendly_fields "$category")"; IFS='|' read -r title why normal action <<< "$fields"
  evidence="$(printf '%s' "$evidence" | head -c 12000)"
  printf '{"timestamp":"%s","severity":"%s","category":"%s","state":"%s","host":"%s","console_user":"%s","message":"%s","evidence":"%s"}\n' "$ts" "$severity" "$category" "$state" "$(printf '%s' "$host"|json_escape)" "$(printf '%s' "$user"|json_escape)" "$(printf '%s' "$message"|json_escape)" "$(printf '%s' "$evidence"|json_escape)" >> "$EVENTS"
  printf '{"timestamp":"%s","severity":"%s","category":"%s","state":"%s","title":"%s","summary":"%s","normal_when":"%s","recommended_action":"%s","message":"%s","evidence":"%s"}\n' "$ts" "$severity" "$category" "$state" "$(printf '%s' "$title"|json_escape)" "$(printf '%s' "$why"|json_escape)" "$(printf '%s' "$normal"|json_escape)" "$(printf '%s' "$action"|json_escape)" "$(printf '%s' "$message"|json_escape)" "$(printf '%s' "$evidence"|json_escape)" >> "$DASH_EVENTS"
  log "[$severity] $category: $message"; notify_user "$severity" "$category" "$title" "$fp"
}

set_active_state(){
  local key="$1" active="$2" severity="$3" category="$4" onmsg="$5" offmsg="$6" evidence="${7:-}" file="$STATE/active-$key" previous=0
  [ -f "$file" ] && previous="$(cat "$file" 2>/dev/null || echo 0)"
  if [ "$active" = 1 ] && [ "$previous" != 1 ]; then emit "$severity" "$category" "$onmsg" "$evidence" "state:$key" active; fi
  if [ "$active" = 0 ] && [ "$previous" = 1 ]; then emit INFO "$category" "$offmsg" "" "state:$key" cleared; fi
  printf '%s' "$active" > "$file"
}

snapshot_diff(){
  local name="$1" severity="$2" category="$3" newfile="$4" oldfile="$SNAP/$name.current"
  if [ ! -f "$oldfile" ]; then cp "$newfile" "$oldfile"; emit INFO "$category" "Initial baseline created for ${name//_/ }" "" "baseline:$name" baseline; return; fi
  if ! cmp -s "$oldfile" "$newfile"; then local d; d="$(diff -u "$oldfile" "$newfile" 2>/dev/null | tail -n +3 | head -n 160)"; emit "$severity" "$category" "${name//_/ } changed" "$d" "change:$name" changed; cp "$newfile" "$oldfile"; fi
}

remote_processes(){ ps -axo pid=,user=,command= 2>/dev/null | awk 'BEGIN{IGNORECASE=1} /\/ARDAgent([ .\/]|$)|\/screensharingd([ .\/]|$)|jumpcloud-assist-(service|launcher)|TeamViewer|AnyDesk|Splashtop|RustDesk|ScreenConnect|ConnectWise|Bomgar|BeyondTrust|LogMeIn|RealVNC|TigerVNC/ {if($0 !~ /MacAudit|awk/) print}'; }

collect_fast(){
  local active rp f pid sockets
  active="$(lsof -nP -iTCP:22 -sTCP:ESTABLISHED 2>/dev/null | tail -n +2)"; [ -n "$active" ] && set_active_state ssh 1 HIGH active-ssh "Active SSH connection detected" "SSH connection ended" "$active" || set_active_state ssh 0 HIGH active-ssh "" "SSH connection ended"
  rp="$(remote_processes)"; [ -n "$rp" ] && set_active_state remoteproc 1 MEDIUM remote-software "Remote-support software started" "Remote-support software is no longer running" "$rp" || set_active_state remoteproc 0 MEDIUM remote-software "" "Remote-support software is no longer running"
  f="$(mktemp)"; for pid in $(printf '%s\n' "$rp" | awk '{print $1}' | grep -E '^[0-9]+$' || true); do sockets="$(lsof -nP -a -p "$pid" -i 2>/dev/null | tail -n +2 | grep -Ev '127\.0\.0\.1|\[::1\]| localhost:|->127\.0\.0\.1|->\[::1\]' || true)"; [ -n "$sockets" ] && { ps -p "$pid" -o pid=,user=,command= >> "$f"; printf '%s\n' "$sockets" >> "$f"; }; done
  [ -s "$f" ] && set_active_state remotesockets 1 MEDIUM remote-sockets "Remote-support software has an external connection" "Remote-support external connection ended" "$(cat "$f")" || set_active_state remotesockets 0 MEDIUM remote-sockets "" "Remote-support external connection ended"; rm -f "$f"
}

collect_standard(){
  local f
  f="$(mktemp)"; { echo "remote_login=$(systemsetup -getremotelogin 2>/dev/null)"; echo "remote_apple_events=$(systemsetup -getremoteappleevents 2>/dev/null)"; launchctl print system/com.apple.screensharing >/dev/null 2>&1 && echo screen_sharing=loaded || echo screen_sharing=not_loaded; pgrep -x ARDAgent >/dev/null 2>&1 && echo ard=running || echo ard=not_running; remote_processes; lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null | awk 'NR==1 || $9 ~ /:(22|5900|3283)$/' || true; } | sort > "$f"; snapshot_diff remote_access HIGH remote-access "$f"; rm -f "$f"
  f="$(mktemp)"; { find /Users -path '*/.ssh/authorized_keys' -type f -maxdepth 4 -exec shasum -a 256 {} \; 2>/dev/null | sort; [ -f /var/root/.ssh/authorized_keys ] && shasum -a 256 /var/root/.ssh/authorized_keys; [ -f /etc/ssh/sshd_config ] && shasum -a 256 /etc/ssh/sshd_config; } > "$f"; snapshot_diff ssh_configuration HIGH ssh "$f"; rm -f "$f"
  f="$(mktemp)"; { dscl . list /Users UniqueID 2>/dev/null | awk '$2 >= 500 {print}' | sort; dscl . read /Groups/admin GroupMembership 2>/dev/null; } > "$f"; snapshot_diff user_and_admin_accounts CRITICAL identity "$f"; rm -f "$f"
  f="$(mktemp)"; { echo "sip=$(csrutil status 2>/dev/null)"; echo "gatekeeper=$(spctl --status 2>/dev/null)"; echo "filevault=$(fdesetup status 2>/dev/null)"; echo "firewall=$(defaults read /Library/Preferences/com.apple.alf globalstate 2>/dev/null || echo unknown)"; echo "stealth=$(defaults read /Library/Preferences/com.apple.alf stealthenabled 2>/dev/null || echo unknown)"; echo "remote_login=$(systemsetup -getremotelogin 2>/dev/null)"; } > "$f"; snapshot_diff security_settings HIGH security-settings "$f"; rm -f "$f"
  f="$(mktemp)"; { for d in /Library/LaunchDaemons /Library/LaunchAgents /Users/*/Library/LaunchAgents; do [ -d "$d" ] && find "$d" -maxdepth 1 -type f -name '*.plist' -exec shasum -a 256 {} \; 2>/dev/null; done; find /etc/periodic -type f -maxdepth 3 -exec shasum -a 256 {} \; 2>/dev/null; } | sort > "$f"; snapshot_diff automatic_start_items HIGH persistence "$f"; rm -f "$f"
}

collect_slow(){
  local f found db
  f="$(mktemp)"; { profiles status -type enrollment 2>/dev/null || true; profiles show -type enrollment 2>/dev/null || true; systemextensionsctl list 2>/dev/null || true; } > "$f"; snapshot_diff device_management HIGH device-management "$f"; rm -f "$f"
  f="$(mktemp)"; { find /Applications /Users/*/Applications -maxdepth 1 -type d -name '*.app' -print 2>/dev/null | sort; pkgutil --pkgs 2>/dev/null | sort; } > "$f"; snapshot_diff installed_software MEDIUM software "$f"; rm -f "$f"
  [ "$ENABLE_TCC_SCAN" = 1 ] && { f="$(mktemp)"; found=0; for db in "/Library/Application Support/com.apple.TCC/TCC.db" /Users/*/Library/Application\ Support/com.apple.TCC/TCC.db; do [ -f "$db" ] || continue; if sqlite3 "$db" 'select service,client,auth_value,auth_reason,last_modified from access order by service,client;' >> "$f" 2>/dev/null; then found=1; else echo "UNREADABLE:$db" >> "$f"; fi; done; sort -u "$f" -o "$f"; snapshot_diff privacy_permissions HIGH privacy-permissions "$f"; [ "$found" -eq 0 ] && emit LOW privacy-permissions "Privacy permission databases could not be read" "Grant Full Disk Access to the MacAudit executable only if your organisation approves it." "tcc-unreadable" degraded; rm -f "$f"; }
}

due(){
  local name interval stamp now last
  name="$1"
  interval="$2"
  stamp="$STATE/due-$name"
  last=0
  now="$(date +%s)"
  [ -f "$stamp" ] && last="$(cat "$stamp" 2>/dev/null || echo 0)"
  [ $((now-last)) -ge "$interval" ] || return 1
  printf '%s' "$now" > "$stamp"
}
run_group(){ local name="$1" start ok=1; shift; start="$(date +%s)"; "$@" || ok=0; printf '{"name":"%s","ok":%s,"duration_seconds":%s}' "$name" "$([ "$ok" -eq 1 ] && echo true || echo false)" "$(( $(date +%s)-start ))"; return "$((1-ok))"; }

prune_event_history(){
  local python_bin="" file tmp
  for python_bin in /usr/bin/python3 /opt/homebrew/bin/python3 /usr/local/bin/python3; do [ -x "$python_bin" ] && break; done
  [ -x "$python_bin" ] || { log "History pruning skipped: Python 3 not found"; return 0; }
  for file in "$EVENTS" "$DASH_EVENTS"; do
    [ -f "$file" ] || continue
    tmp="$file.prune.$$"
    if "$python_bin" - "$file" "$tmp" "$RETENTION_DAYS" <<'PYRET'
import json, os, sys
from datetime import datetime, timedelta, timezone
src, dst, days = sys.argv[1], sys.argv[2], int(sys.argv[3])
cutoff = datetime.now(timezone.utc) - timedelta(days=days)
kept = []
with open(src, 'r', encoding='utf-8', errors='replace') as handle:
    for line in handle:
        try:
            item = json.loads(line)
            stamp = str(item.get('timestamp', '')).replace('Z', '+00:00')
            parsed = datetime.fromisoformat(stamp)
            if parsed.tzinfo is None:
                parsed = parsed.replace(tzinfo=timezone.utc)
            if parsed.astimezone(timezone.utc) >= cutoff:
                kept.append(json.dumps(item, separators=(',', ':'), ensure_ascii=False))
        except (ValueError, TypeError, json.JSONDecodeError):
            continue
with open(dst, 'w', encoding='utf-8') as handle:
    if kept:
        handle.write('\n'.join(kept) + '\n')
os.chmod(dst, 0o600)
PYRET
    then mv "$tmp" "$file"; else rm -f "$tmp"; log "History pruning failed for $file"; fi
  done
}

run_all(){
  require_root; setup; acquire_lock; local started completed fast='null' standard='null' slow='null' failures=0
  started="$(now_iso)"
  due fast "$FAST_INTERVAL_SECONDS" && fast="$(run_group fast collect_fast)" || true
  due standard "$STANDARD_INTERVAL_SECONDS" && standard="$(run_group standard collect_standard)" || true
  due slow "$SLOW_INTERVAL_SECONDS" && slow="$(run_group slow collect_slow)" || true
  prune_event_history
  find "$LOG_DIR" -type f ! -name 'events.jsonl' -mtime "+$RETENTION_DAYS" -delete 2>/dev/null || true
  completed="$(now_iso)"; printf '{"version":"%s","status":"ok","started_at":"%s","completed_at":"%s","groups":{"fast":%s,"standard":%s,"slow":%s}}\n' "$VERSION" "$started" "$completed" "$fast" "$standard" "$slow" > "$HEALTH"; chmod 600 "$HEALTH"
}

status(){ setup; echo "MacAudit $VERSION"; [ -r "$HEALTH" ] && cat "$HEALTH" || echo "No successful scan yet."; launchctl print system/com.local.macaudit 2>/dev/null | head -n 20 || true; }
open_dashboard(){ setup; local token_file="$BASE/dashboard.token" token uid user url; [ -r "$token_file" ] || { echo "Dashboard token is missing. Re-run the installer." >&2; exit 1; }; token="$(cat "$token_file")"; uid="$(stat -f '%u' /dev/console 2>/dev/null || echo 0)"; user="$(stat -f '%Su' /dev/console 2>/dev/null || true)"; url="http://127.0.0.1:$DASHBOARD_PORT/?token=$token"; echo "Opening the private MacAudit dashboard."; [ "$uid" -gt 500 ] && launchctl asuser "$uid" sudo -u "$user" open "$url" >/dev/null 2>&1 || echo "$url"; }

case "${1:-run}" in
 run) run_all;; status) require_root; status;; dashboard) require_root; open_dashboard;; report) require_root; setup; tail -n "${2:-100}" "$EVENTS";; baseline) require_root; setup; rm -f "$SNAP"/*.current; run_all;; notify-test) require_root; setup; emit HIGH test "MacAudit notification test succeeded" "Local notification test" "notify-test-$(date +%s)" test;; *) echo 'Usage: macaudit {run|status|dashboard|report [lines]|baseline|notify-test}'; exit 2;; esac
